<AnchorPane fx:id="AnchorMainPanaloInfo" prefHeight="768.0" prefWidth="1366.0" styleClass="parent-body" stylesheets="@../css/StyleSheet.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <children>
